<?xml version="1.0" encoding="UTF-8"?>
<?pde version="3.5"?>

<product name="Odysseus Studio 2" uid="de.uniol.inf.is.odysseus.studio.product.monolithic" id="de.uniol.inf.is.odysseus.client.starter.OdysseusStudioProduct" application="de.uniol.inf.is.odysseus.client.starter.OdysseusStudioApplication" version="1.0.0" type="features" includeLaunchers="true" autoIncludeRequirements="false">

   <aboutInfo>
      <image path="icons/128_128.gif"/>
      <text>
         This is Odysseus Studio

Help can be found here:

http://odysseus.informatik.uni-oldenburg.de/
      </text>
   </aboutInfo>

   <configIni use="default">
   </configIni>

   <launcherArgs>
      <programArgs>-console -clean -debug -nl en -data @noDefault
      </programArgs>
      <programArgsLin>--launcher.GTK_version 
2
      </programArgsLin>
      <vmArgs>-Xms12000M -Xmx12000M -Xms12000M -Xmx12000M -XX:+UseG1GC -Dsysredirect=true -Declipse.p2.mirrors=false -Declipse.log.level=ERROR -Dlogback.configurationFile=logback.xml
      </vmArgs>
      <vmArgsMac>-XstartOnFirstThread -Dorg.eclipse.swt.internal.carbon.smallFonts
      </vmArgsMac>
   </launcherArgs>

   <windowImages i16="icons/16_16.gif" i32="icons/32_32.gif" i48="icons/48_48.gif" i64="icons/64_64.gif" i128="icons/128_128.gif"/>

   <splash
      location="de.uniol.inf.is.odysseus.client.starter" />
   <launcher name="studio">
      <linux icon="icons/Odysseus-icons-linux.xpm"/>
      <macosx icon="icons/Odysseus-icons-mac.icns"/>
      <win useIco="true">
         <ico path="icons/Odysseus-icons-win.ico"/>
         <bmp/>
      </win>
   </launcher>

   <vm>
   </vm>

